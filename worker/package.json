{
  "name": "kaist-run-auth-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "sync-members": "curl -X POST -H \"x-admin-secret: $ADMIN_SYNC_SECRET\" https://kaist.run/api/admin/sync-members",
    "backfill-email-index": "curl -X POST -H \"x-admin-secret: $ADMIN_SYNC_SECRET\" https://kaist.run/api/admin/backfill-email-index"
  },
  "dependencies": {
    "hono": "^4",
    "jose": "^5",
    "postal-mime": "^2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "typescript": "^5",
    "wrangler": "^4.120.0"
  }
}
