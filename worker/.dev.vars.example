# 로컬 개발용 시크릿 예시입니다. 실제 값을 채운 뒤 파일명을 .dev.vars로 바꾸세요.
# .dev.vars는 .gitignore에 있어서 커밋되지 않습니다.
# 프로덕션 값은 여기 두지 말고 `wrangler secret put <이름>`으로 등록하세요.

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 로그인용 OAuth 앱과는 별개로, 임의의 Discord 계정 프로필 사진을 조회하기 위한
# 봇 토큰입니다(신규 유저 등록 시 아바타 미리 채우기 등). Discord Developer Portal →
# 해당 앱 → Bot → Token에서 발급하세요(서버에 초대할 필요는 없음 — GET /users/{id}는
# 봇 토큰만 있으면 전역으로 동작).
DISCORD_BOT_TOKEN=

# 디스코드 봇이 /api/bot/*(신규 회원가입, 학기별 활동회원 등록)을 호출할 때 쓰는
# 별도 시크릿입니다. ADMIN_SYNC_SECRET과 독립적으로 회전/폐기할 수 있게 나눠뒀습니다.
DISCORD_BOT_API_SECRET=

# 순수 로컬 테스트를 하려면(배포 전) 이 값을 로컬 Worker 주소로 바꾸고,
# Discord Developer Portal에도 같은 주소를 Redirect로 추가 등록하세요.
# 안 쓰면 wrangler.jsonc의 vars.DISCORD_REDIRECT_URI(프로덕션 값)가 쓰입니다.
# DISCORD_REDIRECT_URI=http://localhost:8787/api/auth/discord/callback

# 회원 데이터의 원천은 이제 D1(users/admins/semester_membership)입니다 — 아래
# 넷은 오직 1회성 이관 라우트(POST /api/admin/migrate-members)가 옛 스프레드시트를
# 읽어올 때만 쓰입니다. 이관을 실제로 완료하고 나면(README 참고) 통째로 지워도 됩니다.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
ROSTER_ALL_TIME_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1

# /api/admin/migrate-members(1회성 이관) 등 관리용 API 호출 시 쓰는 임의의 긴 문자열
ADMIN_SYNC_SECRET=

# EMAIL_FORWARD_TO는 시크릿이 아니라 wrangler.jsonc의 vars에 이미 있어서 보통은
# 안 채워도 됩니다. 로컬에서 실제 발신 없이 다른 Gmail 주소로 테스트하고 싶을
# 때만 여기서 덮어쓰세요.
# EMAIL_FORWARD_TO=

# backstage에서 공지/아카이브/연락처를 저장했을 때 GitHub Actions(deploy.yml)를
# 재실행시켜 정적 사이트를 재빌드하기 위한 토큰입니다. 이 저장소의 "Actions: write"
# 권한만 있는 fine-grained PAT로 발급하세요 (Contents 권한은 필요 없음 — 코드를
# 직접 쓰지 않고 이미 있는 워크플로만 재실행시킵니다).
# https://github.com/settings/personal-access-tokens/new
GITHUB_ACTIONS_TOKEN=
